// =========================================================================
// SENSORES DE LÍNEA TCRT5000 Y NAVEGACIÓN
// =========================================================================

// Umbral analógico para diferenciar superficie clara de línea negra
int UMBRAL_NEGRO_DER = 55;
int UMBRAL_NEGRO_IZQ = 31;

int leerLineaIzq() {
  return analogRead(PIN_TCRT_IZQ);
}

int leerLineaDer() {
  return analogRead(PIN_TCRT_DER);
}

bool esNegroIzq() {
  return leerLineaIzq() >= UMBRAL_NEGRO_IZQ;
}

bool esNegroDer() {
  return leerLineaDer() >= UMBRAL_NEGRO_DER;
}

void imprimirSensoresLinea() {
  Serial.print("TCRT Izq (A4): ");
  Serial.print(leerLineaIzq());
  Serial.print(" | TCRT Der (A3): ");
  Serial.println(leerLineaDer());
}

/**
 * Centra el robot sobre la línea negra usando micro-ajustes.
 */
void centrarEnLinea(float velocidad, float timeoutSeg) {
  unsigned long inicio = millis();
  unsigned long timeoutMs = (unsigned long)(timeoutSeg * 1000.0);
  float velFina = abs(velocidad) * 0.6; // Velocidad reducida para mayor precisión

  while (millis() - inicio < timeoutMs) {
    _loop();
    bool izqNegro = esNegroIzq();
    bool derNegro = esNegroDer();

    // Si ambos detectan negro o ambos blanco, el robot ya está centrado
    if ((izqNegro && derNegro) || (!izqNegro && !derNegro)) {
      Encoder_1.runSpeed(0);
      Encoder_2.runSpeed(0);
      break;
    } 
    else if (izqNegro && !derNegro) {
      // Línea hacia la izquierda -> girar izquierda
      Encoder_1.runSpeed(velFina);
      Encoder_2.runSpeed(velFina);
    } 
    else if (!izqNegro && derNegro) {
      // Línea hacia la derecha -> girar derecha
      Encoder_1.runSpeed(-velFina);
      Encoder_2.runSpeed(-velFina);
    }
    delay(5);
  }

  Encoder_1.runSpeed(0);
  Encoder_2.runSpeed(0);
  _delay(0.1);
}

/**
 * Girar a la izquierda con giroscopio y centrarse en la línea negra al detectarla.
 * 
 * @param gradosMaximos Límite máximo de grados a girar si el sensor no detecta la línea.
 * @param velocidad Velocidad de giro.
 * @param gradosMinimosBusqueda Grados transcurridos ANTES de activar la búsqueda por sensor (evita lecturas falsas al iniciar).
 * @param timeoutSeg Tiempo límite de seguridad en segundos.
 */
void girarIzquierdaGyroLinea(float gradosMaximos, float velocidad, float gradosMinimosBusqueda, float timeoutSeg = 4.0) {
  giroscopio.update();
  float anguloInicial = giroscopio.getAngleZ();
  unsigned long tiempoInicio = millis();
  unsigned long timeoutMs = (unsigned long)(timeoutSeg * 1000.0);

  Encoder_1.runSpeed(abs(velocidad));
  Encoder_2.runSpeed(abs(velocidad));

  bool lineaDetectada = false;

  while (abs(giroscopio.getAngleZ() - anguloInicial) < gradosMaximos) {
    _loop();
    float gradosGirados = abs(giroscopio.getAngleZ() - anguloInicial);

    // Activar la lectura de la línea solo después de cumplir los grados/pasos mínimos
    if (gradosGirados >= gradosMinimosBusqueda) {
      if (esNegroIzq() || esNegroDer()) {
        lineaDetectada = true;
        break; // Detener giro inmediatamente al detectar la línea
      }
    }

    if (millis() - tiempoInicio > timeoutMs) {
      Serial.println("TIMEOUT en girarIzquierdaGyroLinea - saliendo por seguridad");
      break;
    }
  }

  Encoder_1.runSpeed(0);
  Encoder_2.runSpeed(0);
  _delay(0.1);

  // Si se detectó la línea, realizar el centrado fino
  if (lineaDetectada) {
    centrarEnLinea(velocidad, 40.0);
  }
}

/**
 * Girar a la derecha con giroscopio y centrarse en la línea negra al detectarla.
 * 
 * @param gradosMaximos Límite máximo de grados a girar si el sensor no detecta la línea.
 * @param velocidad Velocidad de giro.
 * @param gradosMinimosBusqueda Grados transcurridos ANTES de activar la búsqueda por sensor.
 * @param timeoutSeg Tiempo límite de seguridad en segundos.
 */
void girarDerechaGyroLinea(float gradosMaximos, float velocidad, float gradosMinimosBusqueda, float timeoutSeg = 4.0) {
  giroscopio.update();
  float anguloInicial = giroscopio.getAngleZ();
  unsigned long tiempoInicio = millis();
  unsigned long timeoutMs = (unsigned long)(timeoutSeg * 1000.0);

  Encoder_1.runSpeed(-abs(velocidad));
  Encoder_2.runSpeed(-abs(velocidad));

  bool lineaDetectada = false;

  while (abs(giroscopio.getAngleZ() - anguloInicial) < gradosMaximos) {
    _loop();
    float gradosGirados = abs(giroscopio.getAngleZ() - anguloInicial);

    if (gradosGirados >= gradosMinimosBusqueda) {
      if (esNegroIzq() || esNegroDer()) {
        lineaDetectada = true;
        break;
      }
    }

    if (millis() - tiempoInicio > timeoutMs) {
      Serial.println("TIMEOUT en girarDerechaGyroLinea - saliendo por seguridad");
      break;
    }
  }

  Encoder_1.runSpeed(0);
  Encoder_2.runSpeed(0);
  _delay(0.1);

  if (lineaDetectada) {
    centrarEnLinea(velocidad, 40.0);
  }
}

/**
 * Avanza siguiendo la línea negra durante un tiempo determinado (en segundos).
 * 
 * @param segundos Tiempo total de avance.
 * @param velocidadBase Velocidad crucero del robot.
 * @param Kp Constante de proporcionalidad para el ajuste de dirección.
 */
void seguirLineaTiempo(float segundos, float velocidadBase, float Kp = 0.15) {
  unsigned long inicio = millis();
  unsigned long duracionMs = (unsigned long)(segundos * 1000.0);

  while (millis() - inicio < duracionMs) {
    _loop();

    int lectIzq = leerLineaIzq();
    int lectDer = leerLineaDer();

    // Diferencia proporcional entre ambos sensores
    int error = lectIzq - lectDer;
    float correccion = error * Kp;

    float velIzq = velocidadBase - correccion;
    float velDer = velocidadBase + correccion;

    Encoder_1.runSpeed(velIzq);
    Encoder_2.runSpeed(-velDer);

    delay(5);
  }

  Encoder_1.runSpeed(0);
  Encoder_2.runSpeed(0);
  _delay(0.1);
}

/**
 * Avanza siguiendo la línea negra durante una cantidad determinada de grados/pasos de encoder.
 * 
 * @param grados Grados de avance requeridos en los motores.
 * @param velocidadBase Velocidad crucero del robot.
 * @param Kp Constante de proporcionalidad.
 * @param tiempoMax Tiempo límite de seguridad por timeout.
 */
void seguirLineaGrados(long grados, float velocidadBase, float Kp = 0.15, float tiempoMax = 10.0) {
  long posInicialIzq = Encoder_1.getCurPos();
  long posInicialDer = Encoder_2.getCurPos();

  unsigned long inicio = millis();
  unsigned long timeoutMs = (unsigned long)(tiempoMax * 1000.0);

  while (millis() - inicio < timeoutMs) {
    _loop();

    long avanceIzq = abs(Encoder_1.getCurPos() - posInicialIzq);
    long avanceDer = abs(Encoder_2.getCurPos() - posInicialDer);
    long promedioAvance = (avanceIzq + avanceDer) / 2;

    if (promedioAvance >= grados) {
      break;
    }

    int lectIzq = leerLineaIzq();
    int lectDer = leerLineaDer();

    int error = lectIzq - lectDer;
    float correccion = error * Kp;

    float velIzq = velocidadBase - correccion;
    float velDer = velocidadBase + correccion;

    Encoder_1.runSpeed(velIzq);
    Encoder_2.runSpeed(-velDer);

    delay(5);
  }

  Encoder_1.runSpeed(0);
  Encoder_2.runSpeed(0);
  _delay(0.1);
}

