#define BOTON_PIN 4
#define PIN_TCRT_IZQ A4
#define PIN_TCRT_DER A3

MeGyro giroscopio(8);

MePort placaExpansora(7); // Define el Puerto 7 como adaptador RJ25
Servo servoGarra1;
Servo servoGarra2;

double angle_rad = PI/180.0;
double angle_deg = 180.0/PI;
MeEncoderOnBoard Encoder_1(SLOT1); // Motor Izquierdo
MeEncoderOnBoard Encoder_2(SLOT2); // Motor Derecho

void isr_process_encoder1(void){
  if(digitalRead(Encoder_1.getPortB()) == 0){
    Encoder_1.pulsePosMinus();
  }else{
    Encoder_1.pulsePosPlus();
  }
}

void isr_process_encoder2(void){
  if(digitalRead(Encoder_2.getPortB()) == 0){
    Encoder_2.pulsePosMinus();
  }else{
    Encoder_2.pulsePosPlus();
  }
}

// Variable para saber si estamos en espera o si el robot ya está compitiendo
bool rutinaIniciada = false;

void _loop() {
  unsigned long tiempoActual = millis(); 
  
  // Actualizar los motores solo cada 10 milisegundos
  static unsigned long ultimoTiempoMotores = 0;
  if(tiempoActual - ultimoTiempoMotores >= 10) {
    Encoder_1.loop();
    Encoder_2.loop();
    ultimoTiempoMotores = tiempoActual;
  }
  
  // Actualizar el giroscopio solo cada 50 milisegundos
  static unsigned long ultimoGiroscopio = 0;
  if(tiempoActual - ultimoGiroscopio >= 25) {
    giroscopio.update();
    ultimoGiroscopio = tiempoActual;
  }

  // Si la rutina ya empezó y el botón se vuelve a presionar (estado LOW)
  if (rutinaIniciada == true && digitalRead(BOTON_PIN) == LOW) {
    // 1. Mandamos la orden de velocidad y posición a 0
    Encoder_1.move(0, 0); 
    Encoder_2.move(0, 0);
    // Forzar el PWM a 0
    Encoder_1.setTarPWM(0);
    Encoder_2.setTarPWM(0);
    
    // Guardamos el momento exacto en el que empezamos a frenar
    unsigned long inicioParada = millis();
    
    // 2. Atrapamos al robot en un bucle infinito
    while (true) {
      tiempoActual = millis(); 
      
      // FASE 1: Durante los primeros 1500ms, mantenemos vivo el cerebro del motor para que frene
      if (tiempoActual - inicioParada < 1500) {
        if(tiempoActual - ultimoTiempoMotores >= 10) {
          Encoder_1.loop();
          Encoder_2.loop();
          ultimoTiempoMotores = tiempoActual;
        }
      } 
      // FASE 2: Pasados los 500ms, ya no entra al 'if' anterior. 
      // Al dejar de llamar a .loop(), los motores pierden la tensión y el zumbido desaparece.
      else {
        // El robot está congelado, los motores apagados y sin zumbar.
        delay(500);
      }
    }
  }
}

void _delay(float seconds) {
  if(seconds < 0.0){
    seconds = 0.0;
  }
  // Se cambia 'long' por 'unsigned long' para compatibilidad con millis()
  unsigned long endTime = millis() + (unsigned long)(seconds * 1000.0);
  
  while(millis() < endTime) {
    _loop();
    delay(2); // <--- ESTA LÍNEA ES LA MAGIA. Evita que la placa colapse.
  }
}

// =========================================================================
// NUESTRAS FUNCIONES DE MOVIMIENTO
// =========================================================================

/**
 * Función maestra para controlar ambos motores.
 * Para ambos motores: valores positivos = adelante, valores negativos = atrás.
 */
void moverRobot(long gradosIzq, long gradosDer, float velocidad, float tiempoEspera) {
  // Encoder_1 (Izquierdo): se queda igual
  Encoder_1.move(gradosIzq, abs(velocidad));
  
  // Encoder_2 (Derecho): se invierte con el signo menos (-) 
  // para que los valores positivos vayan hacia adelante.
  Encoder_2.move(-gradosDer, abs(velocidad*1.02));
  
  _delay(tiempoEspera);
}

// Mueve el robot en línea recta hacia adelante
void avanzar(long grados, float velocidad, float tiempoEspera) {
  moverRobot(grados, grados, velocidad, tiempoEspera);
}

// Mueve el robot en línea recta hacia atrás
void retroceder(long grados, float velocidad, float tiempoEspera) {
  moverRobot(-grados, -grados, velocidad, tiempoEspera);
}

// Gira sobre su propio eje hacia la derecha
void girarIzquierda(long grados, float velocidad, float tiempoEspera) {
  moverRobot(grados, -grados, velocidad, tiempoEspera);
}

// Gira sobre su propio eje hacia la izquierda
void girarDerecha(long grados, float velocidad, float tiempoEspera) {
  moverRobot(-grados, grados, velocidad, tiempoEspera);
}

// Detiene por completo los motores
void detener(float tiempoEspera) {
  Encoder_1.setTarPWM(0);
  Encoder_2.setTarPWM(0);
}

