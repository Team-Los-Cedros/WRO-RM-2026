const int GARRA_ABIERTA_S1 = 0;
const int GARRA_CERRADA_S1 = 126;
const int GARRA_CERRADA_S2 = 50;
const int GARRA_ABIERTA_S2 = 180;

void abrirGarra() {
  servoGarra1.write(GARRA_ABIERTA_S1);
  servoGarra2.write(GARRA_ABIERTA_S2);
  _delay(1.0);
}

void cerrarGarra() {
  servoGarra1.write(GARRA_CERRADA_S1);
  servoGarra2.write(GARRA_CERRADA_S2);
  _delay(1.0);
}

// =========================================================================
// DEL SERVOMOTOR GRANDE
// =========================================================================

// Creamos el objeto servo
Servo miServo;
// Definimos el pin del servo
const int pinServo = 5;

// Mueve el servo 90° hacia arriba (va a 180°)
const int anguloBajar = 117;
void subir_pala() {
  for (int angulo = anguloBajar; angulo >= 0; angulo--) {
    miServo.write(angulo);
    _delay(0.050); // Ajusta este tiempo para cambiar la velocidad
  }
  _delay(1.0);
}

// Regresa el servo a la posición central (90°)
void bajar_pala() {
  miServo.write(anguloBajar);
  _delay(1.0);
}

// Baja el servo 35° desde el centro (90 - 35 = 55°)
void barrer() {
  abrirGarra();
  miServo.write(117);
  _delay(1.0);
}

// Subir el servo para llevar el objeto
void recolectar(int modo) {
  if (modo == 1) {
    miServo.write(97);
    
  } else if (modo == 2) {
    miServo.write(90);
  }
  _delay(1.0);
}

// Subir el servo para llevar el objeto
void posicionar() {
  miServo.write(50);
  _delay(1.0);
}

// Bajar el servo para soltar el objeto
void depositar() {
  miServo.write(40);
  _delay(1.0);
  abrirGarra();
}

// =========================================================================

void setup() {
  Serial.begin(115200);

  pinMode(BOTON_PIN, INPUT_PULLUP); 
  pinMode(PIN_TCRT_IZQ, INPUT);
  pinMode(PIN_TCRT_DER, INPUT);
  
  Wire.setWireTimeout(3000, true); // 3000 microsegundos, reset automático del bus si se cuelga
  giroscopio.begin(); // <-- AÑADE ESTA LÍNEA
  _delay(2.0);    // <-- AÑADE ESTA LÍNEA (Espera 2 segundos completamente quieto)

  // Asociamos el SERVO al pin 5
  miServo.attach(pinServo);
  // Inicializar los microservomotores
  // Se asignan los servos a los pines físicos extraídos del puerto 7
  servoGarra1.attach(placaExpansora.pin1());
  servoGarra2.attach(placaExpansora.pin2());
  
  // Posición inicial por defecto: siempre en 180 grados
  miServo.write(0);

  // Inicializamos los pines de los servos
  servoGarra1.attach(placaExpansora.pin1());
  servoGarra2.attach(placaExpansora.pin2());
  
  // Condición inicial: Empezar con la garra abierta
  abrirGarra();

  //MOTORES

  TCCR1A = _BV(WGM10);
  TCCR1B = _BV(CS11) | _BV(WGM12);
  TCCR2A = _BV(WGM21) | _BV(WGM20);
  TCCR2B = _BV(CS21);
  
  attachInterrupt(Encoder_1.getIntNum(), isr_process_encoder1, RISING);
  Encoder_1.setPulse(8);
  Encoder_1.setRatio(46.67);
  Encoder_1.setPosPid(1.8,0,1.2);
  Encoder_1.setSpeedPid(0.18,0,0);
  
  attachInterrupt(Encoder_2.getIntNum(), isr_process_encoder2, RISING);
  Encoder_2.setPulse(8);
  Encoder_2.setRatio(46.67);
  Encoder_2.setPosPid(1.8,0,1.2);
  Encoder_2.setSpeedPid(0.18,0,0);
}

